# Discord Bot Token - احصل عليه من https://discord.com/developers/applications
DISCORD_TOKEN=ضع_توكن_البوت_هنا

# Bot Prefix - البادئة للأوامر
PREFIX=!

# YouTube / yt-dlp Settings - إعدادات تشغيل يوتيوب
# اترك cookies فارغة إلا إذا وافقت على استخدام جلسة متصفحك لحل تحقق YouTube.
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
YTDLP_JS_RUNTIME=node
YTDLP_EXTRACTOR_ARGS=youtube:player_client=android

# Welcome Settings - إعدادات الترحيب
# اتركها فارغة ليختار البوت قناة مناسبة تلقائياً
WELCOME_CHANNEL_ID=
WELCOME_COLOR=#5865F2
WELCOME_BANNER_URL=

# Optional Auto Role - رتبة تلقائية اختيارية للأعضاء الجدد
AUTO_ROLE_ID=
